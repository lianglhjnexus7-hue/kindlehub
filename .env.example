# KindleHub 环境变量示例
# 用法：cp .env.example .env && 按需修改（.env 已被 .gitignore 排除）

# 布局配置存放位置。默认 ~/.local/state/kindle-mcp-dashboard/dashboard.json
# 建议指向项目内 .state/ 目录，便于备份与整体删除
KINDLE_DASHBOARD_STATE=./.state/dashboard.json

# 密钥存放位置（权限固定 0600）。
# 与布局配置分离，避免导出布局时把密码带出去
KINDLEHUB_SECRETS=./.state/secrets.json

# 看板地址（WorkBuddy 适配器用）。改成你自己的服务
# 留空则使用 workbuddy.py 里的 DEFAULT_URL
# WORKBUDDY_URL=http://127.0.0.1:8788