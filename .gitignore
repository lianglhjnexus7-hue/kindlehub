# 虚拟环境
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 上游克隆（可重新获取，不入库；commit 记录见 NOTICE）
vendor/

# 运行时状态（含 secrets.json，切勿入库）
.state/
*.log

# 渲染产物与截图（可重新生成）
artifacts/

# 由模板生成本机实例，含绝对路径
deploy/ai.kindlehub.dashboard.plist

# 内部笔记（含本机环境细节与上游代码行号分析，不对外）
internal/

# 环境变量
.env

# 编辑器与系统杂项
.DS_Store
.idea/
.vscode/